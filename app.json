{
  "expo": {
    "name": "busenden",
    "slug": "busenden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./src/assets/logo/app_logo_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#01A89E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Uygulama QR kodları taramak için kamera erişimi gerektirir."
      }
    },
    "android": {
      "package": "com.iweb.busenden",
      "softwareKeyboardLayoutMode": "pan",      
      "windowSoftInputMode": "adjustNothing",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo/app_icon.png",
        "backgroundColor": "#01A89E"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#01A89E",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "favicon": "./src/assets/logo/app_icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e0cc3120-7511-4976-9f27-473b93267683"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-secure-store",
      "expo-barcode-scanner"
    ]
  }
}
